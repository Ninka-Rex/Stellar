{
  "manifest_version": 3,
  "name": "Stellar Integration Module",
  "version": "0.3.1",
  "description": "Intercepts browser downloads and sends them to Stellar download manager.",
  "icons": {
    "16": "icons/milky-way.png",
    "48": "icons/milky-way.png",
    "128": "icons/milky-way.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "shared/popup.html",
    "default_icon": {
      "16": "icons/milky-way.png",
      "48": "icons/milky-way.png"
    }
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "cookies",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "109"
}
